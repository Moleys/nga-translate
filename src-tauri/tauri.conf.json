{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2.0.0/schema.json",
  "productName": "NGA Translate",
  "version": "0.1.0",
  "identifier": "com.ngatranslate.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist",
    "frontendDevServerUrl": "http://localhost:5173"
  },
  "tauri": {
    "bundle": {
      "resources": [
        "data/**"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "NGA Translate",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
