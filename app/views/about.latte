{layout 'layout.latte'}

{block content}
<div class="row">
    <div class="col-lg-8 mx-auto">
        <h1 class="mb-4">{$title}</h1>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">About This Project</h5>
                <p class="card-text">
                    This is a sample application built with:
                </p>
                <ul>
                    <li><strong>Flight PHP</strong> - Lightweight micro-framework</li>
                    <li><strong>Latte</strong> - Secure templating engine</li>
                    <li><strong>Bootstrap 5</strong> - Modern CSS framework</li>
                </ul>
                <p class="card-text mt-3">
                    Perfect for building small to medium-sized web applications with minimal overhead.
                </p>
            </div>
        </div>
    </div>
</div>
{/block}
