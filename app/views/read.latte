{layout 'layout.latte'}

{block content}
<div class="row">
    <div class="col-lg-10 mx-auto">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb" id="thread-breadcrumb">
                <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Home</a></li>
                <li class="breadcrumb-item"><span class="placeholder-glow"><span class="placeholder col-8"></span></span></li>
            </ol>
        </nav>

        <!-- Thread header -->
        <div class="mb-4">
            <h1 class="display-6" id="thread-title">Loading...</h1>
            <p class="text-muted" id="thread-info">Thread ID: {$tid}</p>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <!-- Thread container -->
        <div id="thread-posts" data-tid="{$tid}">
            <div id="posts-list">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3">Loading posts...</p>
                </div>
            </div>

            <!-- Infinite scroll sentinel -->
            <div id="scroll-sentinel" class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status" style="display: none;">
                    <span class="visually-hidden">Loading more...</span>
                </div>
                <p class="mt-2 text-muted small" id="sentinel-text" style="display: none;">Loading more posts...</p>
            </div>

            <div id="scroll-end" class="text-center py-4 text-muted" style="display: none;">
                <i class="bi bi-check-circle"></i> No more posts
            </div>
        </div>
    </div>
</div>

<style>
/* Breadcrumb styling */
.breadcrumb {
    background-color: #f8f9fa;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
}
.breadcrumb-item + .breadcrumb-item::before {
    content: "›";
    font-size: 1.2rem;
    color: #6c757d;
}
.breadcrumb-item a {
    color: #0d6efd;
    text-decoration: none;
}
.breadcrumb-item a:hover {
    color: #0a58ca;
    text-decoration: underline;
}
.breadcrumb-item.active {
    color: #6c757d;
}
/* Loading placeholder */
.placeholder-glow .placeholder {
    background-color: #dee2e6;
}
/* Post card styles */
.post-card {
    transition: box-shadow 0.3s ease;
    scroll-margin-top: 80px; /* For anchor links with fixed header */
}
.post-card:hover {
    box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.1);
}
.post-card:target {
    animation: highlight-post 2s ease;
}
@keyframes highlight-post {
    0% { background-color: #fff3cd; }
    100% { background-color: transparent; }
}
.post-content {
    line-height: 1.7;
    word-wrap: break-word;
}
.post-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 10px 0;
}
.post-content blockquote {
    font-size: 0.95rem;
    background-color: #f8f9fa;
}
/* Reply link style */
.post-content .reply-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    margin: 0 2px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 4px rgba(102, 126, 234, 0.2);
}
.post-content .reply-link:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(102, 126, 234, 0.3);
    color: #fff;
    text-decoration: none;
}
.post-content .reply-link i {
    font-size: 0.8rem;
}
/* User mention style */
.post-content .user-mention {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 8px;
    margin: 0 2px;
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: #fff;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 4px rgba(245, 87, 108, 0.2);
}
.post-content .user-mention:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(245, 87, 108, 0.3);
    color: #fff;
    text-decoration: none;
}
.post-content .user-mention i {
    font-size: 0.8rem;
}
.post-content .badge {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.35em 0.65em;
    margin: 0 2px;
    vertical-align: baseline;
}
.post-content .badge:hover {
    opacity: 0.85;
    text-decoration: none;
}
.post-content a.badge.bg-secondary {
    background-color: #6c757d !important;
}
.post-content a.badge.bg-info {
    background-color: #0dcaf0 !important;
    color: #000 !important;
}
.post-content iframe {
    border: 1px solid #dee2e6;
    border-radius: 8px;
}
.original-post {
    border-left: 4px solid #0d6efd;
    background-color: #f8f9fa;
}
.post-author {
    font-weight: 600;
    color: #0d6efd;
}
.post-floor {
    font-size: 0.875rem;
    color: #6c757d;
}
/* Vote info styling */
.vote-info .badge {
    font-size: 0.75rem;
    font-weight: 500;
}
.vote-info .badge i {
    font-size: 0.7rem;
}
.post-card .vote-info {
    white-space: nowrap;
}
/* Hot posts section */
.hot-posts-section {
    background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
    border-radius: 12px;
    padding: 1rem;
    border: 2px solid #ff6b6b;
}
.hot-posts-header {
    font-size: 1.1rem;
    font-weight: 600;
    color: #e74c3c;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 8px;
}
.hot-posts-header i {
    font-size: 1.2rem;
    animation: fire-flicker 1.5s ease-in-out infinite;
}
@keyframes fire-flicker {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.1); }
}
.hot-post-card {
    background: #fff;
    border-left: 3px solid #ff6b6b;
    box-shadow: 0 2px 4px rgba(255, 107, 107, 0.1);
    transition: all 0.3s ease;
}
.hot-post-card:hover {
    box-shadow: 0 4px 8px rgba(255, 107, 107, 0.2);
    transform: translateX(4px);
}
.hot-post-card .post-content {
    font-size: 0.95rem;
}
.hot-post-card .vote-info .badge {
    font-size: 0.8rem;
}
</style>

<script src="/assets/js/read.js"></script>
{/block}
